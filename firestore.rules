rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'DTORVHWkRQRBLp1vS7JfdVIvVBr1' ||
        request.auth.token.email == 'shivanandkabbur24@gmail.com' ||
        request.auth.token.email.matches('.*admin.*') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 250 &&
             data.description is string && data.description.size() <= 4000 &&
             data.category is string && data.category.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000000 &&
             data.affiliateUrl is string && data.affiliateUrl.size() <= 3000 &&
             data.store is string && data.store.size() <= 100 &&
             data.price is string && data.price.size() <= 100 &&
             data.uploaderId is string && data.uploaderId.size() <= 128 &&
             data.uploaderName is string && data.uploaderName.size() <= 100 &&
             data.createdAt is string &&
             (!('brand' in data) || (data.brand is string && data.brand.size() <= 100)) &&
             (!('editorialNote' in data) || (data.editorialNote is string && data.editorialNote.size() <= 2000)) &&
             (!('originalPrice' in data) || (data.originalPrice is string && data.originalPrice.size() <= 100)) &&
             (!('discountPercent' in data) || data.discountPercent is number) &&
             (!('discountPercentage' in data) || data.discountPercentage is number) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 50)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 15)) &&
             (!('clicksCount' in data) || data.clicksCount is number) &&
             (!('currentPrice' in data) || data.currentPrice is number) &&
             (!('mrp' in data) || (data.mrp is string && data.mrp.size() <= 100)) &&
             (!('discount' in data) || data.discount is number) &&
             (!('offerDescription' in data) || (data.offerDescription is string && data.offerDescription.size() <= 1000)) &&
             (!('dealDescription' in data) || (data.dealDescription is string && data.dealDescription.size() <= 1000)) &&
             (!('offerExpiry' in data) || (data.offerExpiry is string && data.offerExpiry.size() <= 100)) &&
             (!('dealStatus' in data) || (data.dealStatus is string && data.dealStatus.size() <= 50)) &&
             (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 100)) &&
             (!('marketplace' in data) || (data.marketplace is string && data.marketplace.size() <= 100)) &&
             (!('productUrl' in data) || (data.productUrl is string && data.productUrl.size() <= 3000));
    }

    function isValidPriceSnapshot(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.price is number && data.price >= 0 &&
             data.recordedAt is string &&
             data.source is string && data.source.size() <= 100 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('submittedBy' in data) || (data.submittedBy is string && data.submittedBy.size() <= 128)) &&
             (!('approvalMethod' in data) || (data.approvalMethod in ['automatic', 'trusted-user', 'admin'])) &&
             (!('submissionId' in data) || (data.submissionId is string && data.submissionId.size() <= 128));
    }

    function isValidPriceSubmission(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.submittedBy is string && data.submittedBy.size() <= 128 &&
             data.submittedPrice is number && data.submittedPrice > 0 &&
             data.previousApprovedPrice is number &&
             data.priceChangePercentage is number &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.approvalMethod in ['automatic', 'trusted-user', 'admin'] &&
             data.riskLevel in ['low', 'medium', 'high'] &&
             data.submittedAt is string &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 500)) &&
             (!('productTitle' in data) || (data.productTitle is string && data.productTitle.size() <= 250)) &&
             (!('submittedByName' in data) || (data.submittedByName is string && data.submittedByName.size() <= 100)) &&
             (!('submittedByEmail' in data) || (data.submittedByEmail is string && data.submittedByEmail.size() <= 150)) &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
             (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 100)) &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500));
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['admin', 'creator', 'user'] &&
             (!('isTrustedContributor' in data) || data.isTrustedContributor is bool) &&
             (!('approvedSubmissionCount' in data) || data.approvedSubmissionCount is number) &&
             (!('rejectedSubmissionCount' in data) || data.rejectedSubmissionCount is number) &&
             (!('trustScore' in data) || data.trustScore is number) &&
             (!('trustedSince' in data) || (data.trustedSince is string && data.trustedSince.size() <= 100)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('platformFeePaidMonths' in data) || data.platformFeePaidMonths is list) &&
             (!('simulatedClicks' in data) || data.simulatedClicks is number);
    }

    function isValidClick(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.productTitle is string && data.productTitle.size() <= 250 &&
             data.store is string && data.store.size() <= 100 &&
             data.timestamp is string &&
             (!('uploaderId' in data) || (data.uploaderId is string && data.uploaderId.size() <= 128)) &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 2000));
    }

    // Products collection: Public curated affiliate recommendations
    match /products/{productId} {
      allow get, list: if true;

      // Allow creating products with valid product attributes
      allow create: if isValidId(productId) &&
                       isValidProduct(incoming());

      // Creator, admin, or automated price update logic
      allow update: if isValidId(productId) && (
        isAdmin() ||
        isValidProduct(incoming()) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['clicksCount', 'monthlyClicks'])
      );

      // Allow deleting products
      allow delete: if isValidId(productId) && (isAdmin() || (isSignedIn() && existing().uploaderId == request.auth.uid));

      // Subcollection: Immutable chronological price-history snapshots
      // Public users can read approved price history
      match /priceHistory/{snapshotId} {
        allow read: if true;
        allow create: if isValidId(snapshotId) && isValidPriceSnapshot(incoming());
        allow update, delete: if false; // Snapshots cannot be overwritten or deleted
      }
    }

    // Price Submissions collection
    // Authenticated users can submit; users can view only their own submissions; admin can view/manage all
    match /priceSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (
        isAdmin() || resource.data.submittedBy == request.auth.uid
      );

      allow list: if isSignedIn();

      allow create: if isValidId(submissionId) && isSignedIn() &&
                       isValidPriceSubmission(incoming()) &&
                       incoming().submittedBy == request.auth.uid;

      // Only admins or the authenticated submitter during transaction can update
      allow update: if isValidId(submissionId) && isSignedIn() && (
        isAdmin() ||
        (existing().submittedBy == request.auth.uid && isValidPriceSubmission(incoming()))
      );

      allow delete: if isValidId(submissionId) && isAdmin();
    }

    // User profiles collection
    // Private user information is never displayed publicly
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );

      allow list: if isSignedIn();

      allow create: if isValidId(userId) && isSignedIn() &&
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidUserProfile(incoming());

      // Normal users cannot tamper with their own trusted status or trust score
      allow update: if isValidId(userId) && isSignedIn() && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['isTrustedContributor', 'trustScore', 'role']))
      );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Clicks collection: Real-time affiliate click telemetry logs
    match /clicks/{clickId} {
      allow read: if true;
      allow create: if isValidId(clickId) && isValidClick(incoming());
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && existing().uploaderId == request.auth.uid);
    }
  }
}
